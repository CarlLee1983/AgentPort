{
  "name": "agentport-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentport": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' '*.json' 'README.md'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' '*.json' 'README.md'",
    "test": "vitest run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "^13.0.3",
    "smol-toml": "^1.8.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
