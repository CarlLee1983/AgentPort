[Unit]
Description=AgentPort G1 protected Linux launcher harness
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
Environment=AGENTPORT_LAUNCHER_CONFIG=/etc/agentport-g1/launcher.json
ExecStart=/usr/local/bin/node /opt/agentport-g1/current/dist/src/supervisor/linux/launcher-main.js
Restart=on-failure
RestartSec=1s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/agentport-g1 /var/lib/agentport-g1
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
