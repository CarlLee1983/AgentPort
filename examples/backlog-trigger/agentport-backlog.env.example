# Store the real file outside the repository with mode 0600.
AGENTPORT_URL=http://127.0.0.1:3333/
AGENTPORT_TOKEN=replace-with-a-dedicated-caller-token
AGENTPORT_BACKLOG_AGENT=backlog-triage

# Optional: one source of task context. Do not set both.
# AGENTPORT_BACKLOG_PROMPT=Review the open maintenance backlog.
# AGENTPORT_BACKLOG_CONTEXT_FILE=/absolute/path/to/open-issues.json
