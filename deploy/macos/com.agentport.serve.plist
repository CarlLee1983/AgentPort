<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent 範本：以管理者自己的 OS 使用者身分（gui/<uid>）常駐 `agentport serve`，
  讓子程序能讀到 login Keychain 裡的 Claude 訂閱憑證與 ~/.codex/auth.json。
  部署步驟見 README.md「啟動」一節，不要直接編輯 ~/Library/LaunchAgents 下的檔案，
  改這份範本後重新 render。

  佔位符（render 時取代）：
    __NODE__          node 執行檔絕對路徑（`command -v node`）
    __AGENTPORT_DIR__ AgentPort v2 repo 絕對路徑（含 dist/cli.js）
    __HOME__          管理者的 $HOME
    __USER__          管理者的 $USER（Claude Keychain 查詢 `security find-generic-password
                      -a $USER` 依賴這個變數，缺了會回 "Not logged in"）

  token_env 從 __HOME__/.config/agentport/agentport.env（mode 0600）讀入，
  用 Node 內建的 --env-file；缺檔時 node 會直接失敗結束，不會靜默略過。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentport.serve</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>--env-file=__HOME__/.config/agentport/agentport.env</string>
    <string>__AGENTPORT_DIR__/dist/cli.js</string>
    <string>serve</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>USER</key>
    <string>__USER__</string>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__HOME__</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/agentport/serve.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/agentport/serve.err.log</string>
</dict>
</plist>
