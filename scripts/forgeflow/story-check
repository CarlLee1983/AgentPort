# Reads a decision record's single "* Status: <value>" declaration. A decision
# record is a small top-level document, so the status is not scoped to a
# section the way a Story declaration is.
forgeflow_read_decision_status() {
  forgeflow_status_file=$1
  forgeflow_decision_status=
  forgeflow_decision_status_count=0
  forgeflow_fence_length=0

  while IFS= read -r forgeflow_status_line ||
    [ -n "$forgeflow_status_line" ]; do
    forgeflow_trim "$forgeflow_status_line"
    forgeflow_status_line=$forgeflow_trimmed

    forgeflow_update_fence "$forgeflow_status_line"
    [ "$forgeflow_fence_changed" -eq 0 ] || continue
    [ "$forgeflow_fence_length" -eq 0 ] || continue

    case "$forgeflow_status_line" in
      '- '*) forgeflow_status_line="* ${forgeflow_status_line#'- '}" ;;
    esac

    case "$forgeflow_status_line" in
      '* Status: '*)
        forgeflow_decision_status_count=$((forgeflow_decision_status_count + 1))
        forgeflow_decision_status=${forgeflow_status_line#'* Status: '}
        forgeflow_trim "$forgeflow_decision_status"
        forgeflow_decision_status=$forgeflow_trimmed
        ;;
    esac
  done <"$forgeflow_status_file"
}

# Resolves one referenced decision record next to the Story collection, so a
# Story cannot depend on an architecture decision that does not exist or is no
# longer usable. This is the cheapest useful architecture check, not a semantic
# architecture engine.
forgeflow_check_decision() {
  forgeflow_decision_id=$1

  case "$forgeflow_decision_id" in
    ADR-*)
      case "${forgeflow_decision_id#ADR-}" in
        ''|*[!0-9]*)
          forgeflow_story_fail "architecture decision must be ADR-<digits>: $forgeflow_decision_id"
          return
          ;;
      esac
      ;;
    *)
      forgeflow_story_fail "architecture decision must be ADR-<digits>: $forgeflow_decision_id"
      return
      ;;
  esac

  forgeflow_decision_file=
  forgeflow_decision_matches=0

  for forgeflow_decision_candidate in \
    "$forgeflow_decisions_root/$forgeflow_decision_id.md" \
    "$forgeflow_decisions_root/$forgeflow_decision_id"-*.md
  do
    [ -f "$forgeflow_decision_candidate" ] || continue
    if [ -L "$forgeflow_decision_candidate" ]; then
      continue
    fi
    forgeflow_decision_matches=$((forgeflow_decision_matches + 1))
    forgeflow_decision_file=$forgeflow_decision_candidate
  done

  if [ "$forgeflow_decision_matches" -eq 0 ]; then
    forgeflow_story_fail "referenced decision record does not exist: $forgeflow_decision_id"
    return
  fi

  if [ "$forgeflow_decision_matches" -gt 1 ]; then
    forgeflow_story_fail "referenced decision resolves to more than one record: $forgeflow_decision_id"
    return
  fi

  if [ ! -r "$forgeflow_decision_file" ] || [ ! -s "$forgeflow_decision_file" ]; then
    forgeflow_story_fail "referenced decision record is unreadable: $forgeflow_decision_id"
    return
  fi

  forgeflow_read_decision_status "$forgeflow_decision_file"

  if [ "$forgeflow_decision_status_count" -ne 1 ]; then
    forgeflow_story_fail "referenced decision must declare Status exactly once: $forgeflow_decision_id"
    return
  fi

  case "$forgeflow_decision_status" in
    accepted) return ;;
    proposed)
      case "$forgeflow_task_mode" in
        architecture|mixed) return ;;
      esac
      forgeflow_story_fail "referenced decision is still proposed: $forgeflow_decision_id"
      return
      ;;
    superseded|rejected)
      forgeflow_story_fail "referenced decision is not usable ($forgeflow_decision_status): $forgeflow_decision_id"
      return
      ;;
    *)
      forgeflow_story_fail "referenced decision declares an unknown status: $forgeflow_decision_id"
      return
      ;;
  esac
}

forgeflow_check_governance() {
  forgeflow_task_mode=execution
