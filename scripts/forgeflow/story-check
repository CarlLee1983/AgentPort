  forgeflow_decisions=' '
  forgeflow_decision_count=0
  forgeflow_boundaries=$forgeflow_unit_separator
  forgeflow_boundary_count=0
  forgeflow_contract_count=0
  forgeflow_owners=
  forgeflow_owner_count=0
  forgeflow_risk_level=low
  forgeflow_risk_level_count=0
  forgeflow_reasons=
  forgeflow_reason_count=0
  forgeflow_risk_signals=' '

  forgeflow_scan_section "$forgeflow_story_file" '## Classification' \
    forgeflow_task_mode_bullet

  if [ "$forgeflow_task_mode_count" -gt 1 ]; then
    forgeflow_story_fail 'Classification must declare "Task mode" at most once'
    forgeflow_task_mode=execution
  elif [ "$forgeflow_task_mode_count" -eq 1 ]; then
    case "$forgeflow_task_mode" in
      architecture|execution|evidence|mixed) ;;
      *)
        forgeflow_story_fail 'Task mode must be architecture, execution, evidence, or mixed'
        forgeflow_task_mode=execution
        ;;
    esac
  fi

  forgeflow_authority_plan=yes
  forgeflow_authority_add_dependency=no
  forgeflow_authority_migration=no
  forgeflow_authority_commit=no
  forgeflow_authority_push=no
  forgeflow_authority_deploy=no
  case "$forgeflow_task_mode" in
    execution|mixed) forgeflow_authority_modify=yes ;;
    *) forgeflow_authority_modify=no ;;
  esac

  forgeflow_scan_section "$forgeflow_story_file" '## Authority' \
    forgeflow_authority_bullet

  if [ "$forgeflow_section_count" -gt 1 ]; then
    forgeflow_story_fail 'Story must declare ## Authority at most once'
  fi

  # An agent being able to perform an operation is not authorization to perform
  # it, and one grant never implies the next one along the chain.
  if [ "$forgeflow_authority_deploy" = yes ] &&
    [ "$forgeflow_authority_push" != yes ]; then
    forgeflow_story_fail 'authority grants deploy without push'
  fi

  if [ "$forgeflow_authority_push" = yes ] &&
    [ "$forgeflow_authority_commit" != yes ]; then
    forgeflow_story_fail 'authority grants push without commit'
  fi

  if [ "$forgeflow_authority_commit" = yes ] &&
    [ "$forgeflow_authority_modify" != yes ]; then
    forgeflow_story_fail 'authority grants commit without modify'
  fi

  if [ "$forgeflow_task_mode" = evidence ]; then
    for forgeflow_mutating_operation in \
      modify add_dependency migration commit push deploy
    do
      eval "forgeflow_mutating_value=\$forgeflow_authority_$forgeflow_mutating_operation"
      if [ "$forgeflow_mutating_value" = yes ]; then
        forgeflow_story_fail "evidence task mode must not authorize $forgeflow_mutating_operation"
      fi
    done
  fi

  forgeflow_scan_section "$forgeflow_story_file" '## Architecture' \
    forgeflow_architecture_bullet
  forgeflow_architecture_sections=$forgeflow_section_count

  if [ "$forgeflow_architecture_sections" -gt 1 ]; then
    forgeflow_story_fail 'Story must declare ## Architecture at most once'
  fi

  if [ "$forgeflow_impact_count" -gt 1 ]; then
    forgeflow_story_fail 'Architecture must declare "Impact" at most once'
    forgeflow_impact=low
  elif [ "$forgeflow_impact_count" -eq 1 ]; then
    case "$forgeflow_impact" in
      low|medium|high) ;;
      *)
        forgeflow_story_fail 'Architecture impact must be low, medium, or high'
        forgeflow_impact=low
        ;;
    esac
  fi

  case "$forgeflow_impact" in
    medium|high)
      if [ "$forgeflow_decision_count" -eq 0 ] &&
        [ "$forgeflow_contract_count" -eq 0 ]; then
        forgeflow_story_fail "architecture impact $forgeflow_impact must name at least one decision or contract"
      fi
      ;;
  esac

  for forgeflow_referenced_decision in $forgeflow_decisions
  do
    forgeflow_check_decision "$forgeflow_referenced_decision"
  done

  forgeflow_owner_rest=$forgeflow_owners
  while [ -n "$forgeflow_owner_rest" ]; do
    forgeflow_owner_entry=${forgeflow_owner_rest%%"$forgeflow_unit_separator"*}
    forgeflow_owner_rest=${forgeflow_owner_rest#*"$forgeflow_unit_separator"}

    case "$forgeflow_owner_entry" in
      *' = '*) ;;
      *)
        forgeflow_story_fail "architecture owner must be stated as <boundary> = <owner>: $forgeflow_owner_entry"
        continue
        ;;
    esac

    forgeflow_owned_boundary=${forgeflow_owner_entry%%' = '*}
    forgeflow_owning_domain=${forgeflow_owner_entry#*' = '}

    if [ -z "$forgeflow_owning_domain" ]; then
      forgeflow_story_fail "architecture owner names no owning domain: $forgeflow_owner_entry"
      continue
    fi

    case "$forgeflow_boundaries$forgeflow_unit_separator" in
      *"$forgeflow_unit_separator$forgeflow_owned_boundary$forgeflow_unit_separator"*) ;;
      *)
        forgeflow_story_fail "architecture owner names an undeclared boundary: $forgeflow_owned_boundary"
        ;;
    esac
  done

  forgeflow_scan_section "$forgeflow_story_file" '## Risk' forgeflow_risk_bullet

  if [ "$forgeflow_section_count" -gt 1 ]; then
    forgeflow_story_fail 'Story must declare ## Risk at most once'
  fi

  if [ "$forgeflow_risk_level_count" -gt 1 ]; then
    forgeflow_story_fail 'Risk must declare "Level" at most once'
    forgeflow_risk_level=low
  elif [ "$forgeflow_risk_level_count" -eq 1 ]; then
    case "$forgeflow_risk_level" in
      low|medium|high) ;;
      *)
        forgeflow_story_fail 'Risk level must be low, medium, or high'
        forgeflow_risk_level=low
        ;;
    esac
  fi

  case "$forgeflow_risk_level" in
    medium|high)
      [ "$forgeflow_reason_count" -gt 0 ] ||
        forgeflow_story_fail "risk level $forgeflow_risk_level must name at least one reason"
      ;;
  esac

  # Risk raises inspection and verification depth; it never widens scope. A
  # recognized high-risk signal may therefore not be filed as lower risk.
  if [ "$forgeflow_risk_level" != high ]; then
    for forgeflow_declared_reason in $forgeflow_reasons
    do
      case " $forgeflow_high_risk_signals " in
        *" $forgeflow_declared_reason "*)
          forgeflow_story_fail "risk reason $forgeflow_declared_reason is a high-risk signal but the level is $forgeflow_risk_level"
          ;;
      esac
    done
  fi

  forgeflow_check_risk_contracts
}

# One Story ID grammar, shared with scripts/handoff-check: hyphen-separated
# segments of uppercase letters and digits, where the first segment starts with
# an uppercase letter, each middle segment has an uppercase letter, and the last
# segment is digits. DBCLI-PLAT-001 conforms; FF-1-2 does not. Stated in
# protocol/story.md and protocol/handoff.md.
forgeflow_is_story_id() {
  case "$1" in
    *-*) ;;
    *) return 1 ;;
  esac

  forgeflow_id_first=${1%%-*}
  forgeflow_id_last=${1##*-}
  forgeflow_id_rest=${1#*-}

  case "$forgeflow_id_first" in
    ["$forgeflow_upper"]) ;;
    ["$forgeflow_upper"]*)
      case "$forgeflow_id_first" in
        *[!"$forgeflow_upper$forgeflow_digit"]*) return 1 ;;
      esac
      ;;
    *) return 1 ;;
  esac

  case "$forgeflow_id_last" in
    '') return 1 ;;
    *[!"$forgeflow_digit"]*) return 1 ;;
  esac

  while [ "$forgeflow_id_rest" != "$forgeflow_id_last" ]
  do
    forgeflow_id_middle=${forgeflow_id_rest%%-*}

    case "$forgeflow_id_middle" in
      *[!"$forgeflow_upper$forgeflow_digit"]*) return 1 ;;
      *["$forgeflow_upper"]*) ;;
      *) return 1 ;;
    esac

    forgeflow_id_rest=${forgeflow_id_rest#*-}
  done

  return 0
}

# A Story directory is a Story ID followed by an optional readable slug. The ID
# is the shortest leading run of segments that is itself a valid Story ID, so
# FF-227-story-id-grammar names FF-227 and FF-232-API-limits names FF-232. A
# slug is never absorbed into the ID, because the ID stops as soon as it is
# complete.
forgeflow_check_story_id() {
  forgeflow_story_name=$1

  while :; do
    case "$forgeflow_story_name" in
      */) forgeflow_story_name=${forgeflow_story_name%/} ;;
      *) break ;;
    esac
  done

  forgeflow_story_name=${forgeflow_story_name##*/}

  forgeflow_story_id=
  forgeflow_name_rest=$forgeflow_story_name
  forgeflow_name_prefix=
  forgeflow_name_started=0

  while :; do
    forgeflow_name_segment=${forgeflow_name_rest%%-*}

    if [ "$forgeflow_name_started" -eq 0 ]; then
      forgeflow_name_prefix=$forgeflow_name_segment
      forgeflow_name_started=1
    else
      forgeflow_name_prefix="$forgeflow_name_prefix-$forgeflow_name_segment"
    fi

    if forgeflow_is_story_id "$forgeflow_name_prefix"; then
      forgeflow_story_id=$forgeflow_name_prefix
      break
    fi

    case "$forgeflow_name_rest" in
      *-*) forgeflow_name_rest=${forgeflow_name_rest#*-} ;;
      *) break ;;
    esac
  done

  if [ -z "$forgeflow_story_id" ]; then
    forgeflow_story_fail "Story directory does not name a Story ID: $forgeflow_story_name (no leading run of its hyphen-separated segments is one; a Story ID is segments of uppercase letters and digits, where the first segment starts with an uppercase letter, each middle segment has an uppercase letter, and the last segment is digits)"
    return
  fi

  forgeflow_report 'INFO' "Story ID $forgeflow_story_id"
}

forgeflow_check_story() {
  forgeflow_story_directory=$1
  forgeflow_story_label=$forgeflow_story_directory

  forgeflow_story_file="$forgeflow_story_directory/story.md"
  forgeflow_acceptance_file="$forgeflow_story_directory/acceptance.md"

  for forgeflow_required_story_file in \
    "$forgeflow_story_file" "$forgeflow_acceptance_file"
  do
    if [ -L "$forgeflow_required_story_file" ]; then
      printf 'ERROR %s: required Story file is a symlink: %s\n' \
        "$forgeflow_story_label" "$forgeflow_required_story_file" >&2
      forgeflow_operational_error=1
      return
    fi

    if [ ! -f "$forgeflow_required_story_file" ] ||
      [ ! -r "$forgeflow_required_story_file" ] ||
      [ ! -s "$forgeflow_required_story_file" ]; then
      printf 'ERROR %s: required Story file is missing or unreadable: %s\n' \
        "$forgeflow_story_label" "$forgeflow_required_story_file" >&2
      forgeflow_operational_error=1
      return
    fi
  done

  forgeflow_check_story_id "$forgeflow_story_directory"

  if [ "$forgeflow_ready" -eq 1 ]; then
    forgeflow_check_readiness
  fi

  if [ -n "${FORGEFLOW_DECISIONS_ROOT:-}" ]; then
    forgeflow_decisions_root=$FORGEFLOW_DECISIONS_ROOT
  else
    forgeflow_decisions_root="$forgeflow_story_directory/../../decisions"
  fi
  forgeflow_check_governance

  forgeflow_read_declaration \
    "$forgeflow_story_file" '## Classification' 'Security sensitive'
  forgeflow_security_count=$forgeflow_declaration_count
  forgeflow_security=$forgeflow_declaration_value

  forgeflow_read_declaration \
    "$forgeflow_story_file" '## Classification' 'Baseline conformance'
  forgeflow_baseline_count=$forgeflow_declaration_count
  forgeflow_baseline=$forgeflow_declaration_value

  forgeflow_classification_valid=1

  if [ "$forgeflow_security_count" -ne 1 ]; then
    forgeflow_story_fail 'Classification must declare "Security sensitive" exactly once'
    forgeflow_classification_valid=0
  else
    case "$forgeflow_security" in
      yes|no) ;;
      *)
        forgeflow_story_fail 'Security sensitive must be declared as yes or no'
        forgeflow_classification_valid=0
        ;;
    esac
  fi

  if [ "$forgeflow_baseline_count" -ne 1 ]; then
    forgeflow_story_fail 'Classification must declare "Baseline conformance" exactly once'
    forgeflow_classification_valid=0
  else
    case "$forgeflow_baseline" in
      yes|no) ;;
      *)
        forgeflow_story_fail 'Baseline conformance must be declared as yes or no'
        forgeflow_classification_valid=0
        ;;
    esac
  fi

  if [ "$forgeflow_classification_valid" -eq 0 ]; then
    return
  fi

  forgeflow_check_matrix "$forgeflow_acceptance_file"

  forgeflow_count_literal_bullets \
    "$forgeflow_story_file" '## Trust Boundary Fields'
  forgeflow_trust_found=$forgeflow_bullet_section_found
  forgeflow_trust_total=$forgeflow_bullet_total
  forgeflow_trust_literal=$forgeflow_bullet_literal

  forgeflow_count_literal_bullets \
    "$forgeflow_story_file" '## Superseded Behavior'
  forgeflow_superseded_found=$forgeflow_bullet_section_found
  forgeflow_superseded_total=$forgeflow_bullet_total
  forgeflow_superseded_literal=$forgeflow_bullet_literal

  if [ "$forgeflow_security" = 'yes' ]; then
    if [ "$forgeflow_matrix_found" -eq 0 ]; then
      forgeflow_story_fail 'security-sensitive Story is missing acceptance section: ## Security Fixture Matrix'
    elif [ "$forgeflow_matrix_rows" -eq 0 ]; then
      forgeflow_story_fail 'security fixture matrix declares no fixture rows'
    fi

    if [ "$forgeflow_trust_found" -eq 0 ] ||
      [ "$forgeflow_trust_total" -eq 0 ]; then
      forgeflow_story_fail 'security-sensitive Story must enumerate its trust-boundary fields under ## Trust Boundary Fields'
    elif [ "$forgeflow_trust_literal" -ne "$forgeflow_trust_total" ]; then
      forgeflow_story_fail 'every trust-boundary field must name an exact field, not prose'
    fi
  elif [ "$forgeflow_matrix_found" -eq 1 ]; then
    forgeflow_story_fail 'Story declares Security sensitive: no but provides a security fixture matrix'
  fi

  if [ "$forgeflow_baseline" = 'yes' ]; then
    if [ "$forgeflow_superseded_found" -eq 0 ] ||
      [ "$forgeflow_superseded_total" -eq 0 ]; then
      forgeflow_story_fail 'baseline-conformance Story must list superseded tests or behavior under ## Superseded Behavior'
    elif [ "$forgeflow_superseded_literal" -ne \
      "$forgeflow_superseded_total" ]; then
      forgeflow_story_fail 'every superseded entry must name an exact test path or behavior'
    fi
  elif [ "$forgeflow_superseded_found" -eq 1 ]; then
    forgeflow_story_fail 'Story declares Baseline conformance: no but declares superseded behavior'
  fi

  if [ "$forgeflow_contract_incomplete" -eq "$forgeflow_entry_incomplete" ]; then
    forgeflow_report 'PASS' \
      "classification security=$forgeflow_security baseline=$forgeflow_baseline"
  fi
}

forgeflow_upper='ABCDEFGHIJKLMNOPQRSTUVWXYZ'
forgeflow_digit='0123456789'
forgeflow_cr=$(printf '\r')
forgeflow_tab=$(printf '\t')
forgeflow_unit_separator=$(printf '\036')
forgeflow_authority_keys='plan modify add_dependency migration commit push deploy'
forgeflow_high_risk_signals='authentication authorization security payment payments schema-migration data-loss public-contract concurrency production-config dependency-supply-chain destructive-operation'
forgeflow_standard_risk_signals='error-projection concurrency bounded-capacity retention-overflow'
forgeflow_matrix_header_row='| Source field | Payload | Expected result | Persisted locations | Verification |'
forgeflow_evidence_header_row='| AC | Method | Evidence | Fixture / precondition | Expected observation |'
forgeflow_ready=0
if [ "${1-}" = --ready ]; then
  forgeflow_ready=1
  shift
fi

case "${1-}" in
  --help)
    if [ "$#" -ne 1 ] || [ "$forgeflow_ready" -eq 1 ]; then
      usage_error
      exit 2
    fi
    help
    exit 0
    ;;
  -*)
    usage_error
    exit 2
    ;;
esac

forgeflow_contract_incomplete=0
forgeflow_readiness_incomplete=0
forgeflow_operational_error=0
forgeflow_checked=0

printf 'ForgeFlow Story Contract Check\n\n'

if [ "$#" -eq 0 ]; then
  if [ ! -d specs/stories ]; then
    printf 'ERROR Story directory is missing: specs/stories/\n' >&2
    printf '\nResult: ERROR\n'
    printf 'Stories checked: 0\n'
    exit 2
  fi

  for forgeflow_candidate in specs/stories/*
  do
    [ -d "$forgeflow_candidate" ] || continue

    case "$forgeflow_candidate" in
      */_template) continue ;;
    esac

    forgeflow_entry_incomplete=$forgeflow_contract_incomplete
    forgeflow_checked=$((forgeflow_checked + 1))
    forgeflow_check_story "$forgeflow_candidate"
  done
else
  for forgeflow_candidate in "$@"
  do
    case "$forgeflow_candidate" in
      -*) usage_error; exit 2 ;;
    esac
    if [ ! -d "$forgeflow_candidate" ]; then
      printf 'ERROR Story directory is missing: %s\n' \
        "$forgeflow_candidate" >&2
      forgeflow_operational_error=1
      continue
    fi

    forgeflow_entry_incomplete=$forgeflow_contract_incomplete
    forgeflow_checked=$((forgeflow_checked + 1))
    forgeflow_check_story "$forgeflow_candidate"
  done
fi

printf '\n'

if [ "$forgeflow_operational_error" -eq 1 ]; then
  printf 'Result: ERROR\n'
  printf 'Stories checked: %s\n' "$forgeflow_checked"
  exit 2
fi

if [ "$forgeflow_checked" -eq 0 ]; then
  printf 'ERROR No Story directory was checked\n' >&2
  printf 'Result: ERROR\n'
  printf 'Stories checked: 0\n'
  exit 2
fi

if [ "$forgeflow_ready" -eq 1 ]; then
  if [ "$forgeflow_contract_incomplete" -gt 0 ]; then
    printf 'Structure: STORY_CONTRACT_INCOMPLETE\n'
  else
    printf 'Structure: STORY_CONTRACT_OK\n'
  fi
  if [ "$forgeflow_contract_incomplete" -gt 0 ] ||
    [ "$forgeflow_readiness_incomplete" -gt 0 ]; then
    printf 'Result: STORY_READINESS_INCOMPLETE\n'
    printf 'Stories checked: %s\n' "$forgeflow_checked"
    printf 'Fill the reported structure or minimum content, then recheck.\n'
    exit 1
  fi
  printf 'Result: STORY_READINESS_OK\n'
  printf 'Stories checked: %s\n' "$forgeflow_checked"
  printf 'Minimum content only, not human-approved READY. Run make verify and human review.\n'
  exit 0
fi

if [ "$forgeflow_contract_incomplete" -gt 0 ]; then
  printf 'Result: STORY_CONTRACT_INCOMPLETE\n'
  printf 'Stories checked: %s\n\n' "$forgeflow_checked"
  printf 'Next:\n'
  printf 'Record the missing classification, conditional contract, fixture\n'
  printf 'matrix, or superseded behavior in the Story, then recheck.\n'
  exit 1
fi

printf 'Result: STORY_CONTRACT_OK\n'
printf 'Stories checked: %s\n\n' "$forgeflow_checked"
printf 'Next:\n'
printf 'Static Story structure only. Run make verify and human review.\n'
